# Build time (only needed if the API is on a different origin than the app; normally leave empty)
VITE_API_URL=
# Development only: where Vite proxies /api
VITE_DEV_API_TARGET=http://localhost:3000

# Production server (npm start): where /api/* is forwarded. On Railway use the api service's private address:
# API_ORIGIN=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_ORIGIN=
PORT=8080
